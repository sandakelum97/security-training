# Copy to .env for local development. On Vercel, set these in Project Settings → Environment Variables.

# PostgreSQL connection string. For Neon, use the *pooled* connection string (host contains "-pooler").
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Set to "disable" ONLY for a local database without TLS.
# PGSSL=disable

# Random secret, at least 32 characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional
# shown in the header and on certificates
ORG_NAME=Open Security Awareness
# SESSION_HOURS=8
# set false to stop self sign-up
# ALLOW_REGISTRATION=true
# comma-separated; restrict sign-up to your organisation
# ALLOWED_EMAIL_DOMAINS=example.org
# reject passwords found in known breaches (k-anonymity API)
# HIBP_CHECK=true
# APP_ORIGIN=https://training.example.org
# set when behind a reverse proxy (auto on Vercel)
# TRUST_PROXY=1
